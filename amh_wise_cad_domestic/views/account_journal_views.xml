<odoo>
    <record id="account_journal_form_wise_cad_domestic" model="ir.ui.view">
        <field name="name">account.journal.form.wise.cad.domestic</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='outbound_payment_method_line_ids']" position="after">
                <field name="amh_wise_cad_domestic_enabled"
                       invisible="type != 'bank'"/>
            </xpath>
        </field>
    </record>
</odoo>
