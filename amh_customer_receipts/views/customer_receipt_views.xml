<?xml version="1.0" encoding="utf-8"?>
<odoo>

  <record id="view_amh_customer_receipt_form" model="ir.ui.view">
    <field name="name">amh.customer.receipt.form</field>
    <field name="model">amh.customer.receipt</field>
    <field name="arch" type="xml">
      <form string="Customer Receipt">
        <header>
          <!-- Alt+Q fires the payment (Ctrl+Q would quit the browser).
               Creates the payment for the ticked invoices, then opens a fresh
               screen for the next customer. -->
          <button name="action_receive_payment" type="object"
                  string="Receive Payment" class="btn-primary"
                  data-hotkey="q"/>
        </header>
        <sheet>
          <div class="alert alert-success" role="status" invisible="not last_result">
            <field name="last_result" nolabel="1" readonly="1"/>
          </div>
          <!-- Fast keyboard entry: the customer is focused on load, and tab
               order (which follows DOM order) runs Customer -> Cheque/Reference
               -> Amount as the first three stops, so a pile of cheques can be
               keyed straight through without the mouse. The set-once fields
               (Deposit To / Method / Date) and the invoice lookup sit in the
               right column, past Amount, where rapid entry never lands. -->
          <group>
            <group string="Customer">
              <field name="partner_id" options="{'no_create': True}"
                     default_focus="1"/>
              <field name="reference"/>
              <field name="amount"/>
              <field name="partner_display" nolabel="1" widget="text" readonly="1"
                     invisible="not partner_id"/>
            </group>
            <group string="Payment">
              <field name="journal_id"/>
              <field name="payment_method_line_id"/>
              <field name="payment_date"/>
              <field name="invoice_lookup_id" options="{'no_create': True}"
                     context="{'amh_show_residual': True}"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="currency_id" invisible="1"/>
            </group>
          </group>

          <field name="line_ids" nolabel="1">
            <list create="0" delete="0" decoration-danger="is_discrepancy">
              <field name="selected" widget="boolean_toggle"/>
              <field name="move_id" string="Invoice" readonly="1" force_save="1"/>
              <field name="invoice_date" readonly="1"/>
              <field name="date_due" readonly="1"/>
              <field name="description" readonly="1"/>
              <field name="origin" readonly="1" optional="show"/>
              <field name="amount_total" readonly="1" optional="hide"/>
              <field name="amount_residual" readonly="1" sum="Balance"/>
              <field name="is_discrepancy" column_invisible="1"/>
              <field name="currency_id" column_invisible="1"/>
            </list>
          </field>

          <group>
            <group>
              <field name="writeoff"/>
              <field name="writeoff_account_id" invisible="not writeoff"
                     required="writeoff"/>
              <field name="writeoff_limit" invisible="not writeoff"/>
              <field name="has_discrepancy" invisible="1"/>
            </group>
            <group class="oe_subtotal_footer">
              <field name="selected_total"/>
              <field name="difference"/>
            </group>
          </group>
          <div class="text-danger" invisible="not has_discrepancy">
            The amount received does not match the ticked invoices - the rows in
            red are affected. Tick Write Off to close a small difference, or adjust
            the amount / selection.
          </div>
        </sheet>
      </form>
    </field>
  </record>

  <!-- A server action (not a plain act_window) so a blank receipt record is
       created and opened by id - a transient form opened with no res_id renders
       blank full-page. New xml id (the old act_window id cannot be reused for a
       different model). -->
  <record id="action_amh_customer_receipt_screen" model="ir.actions.server">
    <field name="name">Customer Receipts</field>
    <field name="model_id" ref="model_amh_customer_receipt"/>
    <field name="state">code</field>
    <field name="code">action = model.action_open_screen()</field>
  </record>

  <menuitem id="menu_amh_customer_receipt"
            name="Customer Receipts"
            parent="account.menu_finance_receivables"
            action="action_amh_customer_receipt_screen"
            sequence="24"/>

</odoo>
