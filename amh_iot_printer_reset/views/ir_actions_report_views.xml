<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Report form: clear this report's saved IoT printer choice on the
         computer the button is clicked on (see iot_printer_reset.js). -->
    <record id="act_report_xml_view_iot_reset_printer" model="ir.ui.view">
        <field name="name">ir.actions.report.form.iot.reset.printer</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.act_report_xml_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_amh_iot_reset_printer_choice" type="object"
                        icon="fa-print" class="oe_stat_button"
                        invisible="report_type != 'qweb-pdf'"
                        help="Forget which printer this computer uses for this report; the next print asks again">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Reset my printer</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
